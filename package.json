{
  "name": "pulsemarket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
  "test:unit": "vitest run",
  "test:unit:watch": "vitest",
  "test:e2e": "playwright test",
  "dev": "next dev",
  "build": "prisma generate && next build",
  "start": "next start",
  "lint": "next lint --dir src",
